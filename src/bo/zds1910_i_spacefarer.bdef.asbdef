managed implementation in class ZDS1910_BP_SPACEFARER unique;
strict ( 2 );

define behavior for ZDS1910_I_SPACEFARER alias Spacefarer
persistent table zds1910_t_sfarer
lock master
authorization master ( global )
etag master ChangedAt
{
  create;
  update;
  delete;

  action ( authorization : update, lock : none )
    Buy parameter ZDS1910_A_BUY result [1] $self;

  side effects
  {
    action Buy affects $self, entity _Collection, entity _Stardust;
  }

  field ( readonly, numbering : managed ) SpacefarerId;

  field ( readonly )
  CreatedBy,
  CreatedAt,
  ChangedBy,
  ChangedAt;

  field ( mandatory )
  Name,
  NavigationSkill,
  Reputation,
  OriginPlanet,
  SpacesuitColor,
  Credits;

  association _Collection
  {
    create ( authorization : update );
  }

  validation validateSpacefarer on save
  {
    create;
    update;
  }

  validation validateDeletion on save
  {
    delete;
  }

  mapping for zds1910_t_sfarer
    {
      SpacefarerId    = spacefarer_id;
      Name            = name;
      NavigationSkill = navigation_skill;
      Reputation      = reputation;
      OriginPlanet    = origin_planet;
      SpacesuitColor  = spacesuit_color;
      Credits         = credits;
      CreatedBy       = created_by;
      CreatedAt       = created_at;
      ChangedBy       = changed_by;
      ChangedAt       = changed_at;
    }
}

define behavior for ZDS1910_I_COLLECTION alias Collection
persistent table zds1910_t_scoll
lock dependent by _Spacefarer
authorization dependent by _Spacefarer
etag master ChangedAt
{
  delete;

  action ( authorization : update, lock : none )
  Buy parameter ZDS1910_A_BUY result [1] $self;

  action ( authorization : update, lock : none )
  Sell parameter ZDS1910_A_SELL result [1] $self { default function GetDefaultsForSell; }

  action ( authorization : update, lock : none )
  Exchange parameter ZDS1910_A_EXCHANGE result [1] $self { default function GetDefaultsForExchange; }


  side effects
  {
    action Buy affects $self;
    action Sell affects $self, entity _Spacefarer, entity _Stardust;
    action Exchange affects $self, entity _Spacefarer, entity _Stardust;
  }

  field ( readonly )
  StardustCount,
  CollectionValue,
  SpacefarerId,
  CreatedBy,
  CreatedAt,
  ChangedBy,
  ChangedAt;

  association _Spacefarer;

  validation validateDeletion on save
  {
    delete;
  }

  mapping for zds1910_t_scoll
    {
      SpacefarerId = spacefarer_id;
      CreatedBy    = created_by;
      CreatedAt    = created_at;
      ChangedBy    = changed_by;
      ChangedAt    = changed_at;
    }
}